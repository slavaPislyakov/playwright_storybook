{
  "name": "playwright_storybook",
  "version": "1.0.0",
  "description": "Демо UI-кит на React + Vite со средой разработки и автоматизированного тестирования компонентов на базе Storybook 10 и Playwright/test-runner.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --excludeTags=intentional-fail",
    "test-storybook:play": "test-storybook --includeTags=play-fn --excludeTags=intentional-fail",
    "test-storybook:chromium": "test-storybook --browsers chromium --includeTags=play-fn --excludeTags=intentional-fail",
    "test-storybook:firefox": "test-storybook --browsers firefox --includeTags=play-fn --excludeTags=intentional-fail",
    "test-storybook:webkit": "test-storybook --browsers webkit --includeTags=play-fn --excludeTags=intentional-fail",
    "test-storybook:demo": "test-storybook --includeTags=intentional-fail",
    "test-storybook:all": "test-storybook",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@storybook/test-runner": "^0.24.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "http-server": "^14.1.1",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.4.2",
    "wait-on": "^8.0.1"
  },
  "keywords": [
    "storybook",
    "playwright",
    "react",
    "vite",
    "testing",
    "ui-kit",
    "demo"
  ],
  "license": "ISC"
}
