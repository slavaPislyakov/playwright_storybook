{
  "name": "playwright_storybook",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:play": "test-storybook --includeTags=play-fn",
    "test-storybook:chromium": "test-storybook --browsers chromium --includeTags=play-fn",
    "test-storybook:firefox": "  --browsers firefox --includeTags=play-fn",
    "test-storybook:webkit": "test-storybook --browsers webkit --includeTags=play-fn",
    "test-storybook:all-browsers": "test-storybook --browsers chromium firefox webkit --includeTags=play-fn",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jest": "^29.7.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "storybook": "^10.4.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
