{
  "name": "playwright_storybook",
  "version": "1.0.0",
  "description": "Демо UI-кит на React + Vite со средой разработки и автоматизированного тестирования компонентов на базе Storybook 10 и Vitest addon (Playwright browser mode).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "test-storybook:watch": "vitest --project=storybook",
    "test-storybook:chromium": "STORYBOOK_TEST_BROWSERS=chromium vitest run --project=storybook",
    "test-storybook:firefox": "STORYBOOK_TEST_BROWSERS=firefox vitest run --project=storybook",
    "test-storybook:webkit": "STORYBOOK_TEST_BROWSERS=webkit vitest run --project=storybook",
    "test-storybook:demo": "STORYBOOK_TEST_DEMO=1 vitest run --project=storybook",
    "test-storybook:coverage": "STORYBOOK_TEST_BROWSERS=chromium vitest run --project=storybook --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/react-vite": "^10.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "storybook",
    "playwright",
    "react",
    "vite",
    "testing",
    "ui-kit",
    "demo"
  ],
  "license": "ISC"
}
